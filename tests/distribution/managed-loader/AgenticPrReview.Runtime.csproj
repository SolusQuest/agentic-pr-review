<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.9</RuntimeFrameworkVersion>
    <AssemblyName>AgenticPrReview.Runtime</AssemblyName>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableAppHostPackDownload>false</EnableAppHostPackDownload>
    <EnableRuntimePackDownload>false</EnableRuntimePackDownload>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="Dependency/Dependency.csproj" />
  </ItemGroup>
</Project>
