<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InformationalVersion Condition="'$(APRReleasePackage)' != 'true' and '$(APRManagedPackage)' != 'true'">0.1.0-dev</InformationalVersion>
    <InformationalVersion Condition="'$(APRReleasePackage)' == 'true' or '$(APRManagedPackage)' == 'true'">$(APRReleaseVersion)+build.$(APRBuildId)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- CR1-D1 producer-only profile; native defaults remain until CR1-D6 cutover. -->
  <PropertyGroup Condition="'$(APRManagedPackage)' == 'true'">
    <DefineConstants>$(DefineConstants);APR_SOLUS_MANAGED</DefineConstants>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SolusAgentVersion>0.1.0-internal.4</SolusAgentVersion>
    <UseAppHost>false</UseAppHost>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IsAotCompatible>false</IsAotCompatible>
    <VerifyReferenceAotCompatibility>false</VerifyReferenceAotCompatibility>
    <EnableRuntimePackDownload>false</EnableRuntimePackDownload>
    <EnableAppHostPackDownload>false</EnableAppHostPackDownload>
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ActionHostVerifierFrameworkReference)' == 'true'">
    <OutputType>Library</OutputType>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <IntermediateOutputPath Condition="'$(ArtifactsPath)' == ''">obj\$(Configuration)\$(TargetFramework)\action-host-verifier\</IntermediateOutputPath>
    <OutputPath Condition="'$(ArtifactsPath)' == ''">bin\$(Configuration)\$(TargetFramework)\action-host-verifier\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ActionHostVerifierAotReference)' == 'true'">
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ActionHostTrustedProofPayloadReference)' == 'true'">
    <OutputType>Library</OutputType>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <IntermediateOutputPath Condition="'$(ArtifactsPath)' == ''">obj\$(Configuration)\$(TargetFramework)\action-host-trusted-proof-payload\</IntermediateOutputPath>
    <OutputPath Condition="'$(ArtifactsPath)' == ''">bin\$(Configuration)\$(TargetFramework)\action-host-trusted-proof-payload\</OutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(ActionHostVerifierFrameworkReference)' == 'true'">
    <Compile Remove="Cli\Program.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(ActionHostVerifierAotReference)' == 'true'">
    <Compile Remove="Cli\Program.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(ActionHostTrustedProofPayloadReference)' == 'true'">
    <Compile Remove="Cli\Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.2.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(APRManagedPackage)' == 'true'">
    <PackageReference Update="JsonSchema.Net" Version="[9.2.2]" />
    <PackageReference Include="SolusAgent.Api" Version="[$(SolusAgentVersion)]" />
    <PackageReference Include="SolusAgent.Tools.Api" Version="[$(SolusAgentVersion)]" />
    <PackageReference Include="SolusAgent.Runtime.Api" Version="[$(SolusAgentVersion)]" />
    <PackageReference Include="SolusAgent.Runtime" Version="[$(SolusAgentVersion)]" />
    <PackageReference Include="SolusAgent.Providers.DeepSeek" Version="[$(SolusAgentVersion)]" />
  </ItemGroup>
  <ItemGroup Condition="'$(APRManagedPackage)' != 'true'">
    <Compile Remove="Solus/**/*.cs" />
    <Compile Remove="Execution/Solus/**/*.cs" />
    <Compile Remove="Application/Solus/**/*.cs" />
  </ItemGroup>
  <Target Name="ValidateSolusManagedProfile" BeforeTargets="_GenerateRestoreGraphProjectEntry;CollectPackageReferences;PrepareForBuild"
          Condition="'$(APRManagedPackage)' == 'true'">
    <Error Condition="'$(APRReleasePackage)' == 'true' or '$(PublishAot)' != 'false' or '$(IsAotCompatible)' != 'false' or '$(SelfContained)' != 'false' or '$(PublishTrimmed)' == 'true' or '$(PublishSingleFile)' == 'true' or '$(UseAppHost)' != 'false' or '$(SolusAgentVersion)' != '0.1.0-internal.4' or '$(TargetFramework)' != 'net10.0'"
           Text="APR_SOLUS_MANAGED_PROFILE_UNSUPPORTED" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="..\..\tests\fixtures\action-host\trusted-proof-payload\workflow\r4-trusted-proof.yml.template"
                      LogicalName="AgenticPrReview.Runtime.ActionHost.TrustedProofWorkflowTemplate" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\protocol\schemas\review-input.v1.json" LogicalName="AgenticPrReview.Protocol.review-input.v1.json" />
    <EmbeddedResource Include="..\..\..\protocol\schemas\review-result.v1.json" LogicalName="AgenticPrReview.Protocol.review-result.v1.json" />
    <EmbeddedResource Include="..\..\..\protocol\schemas\review-trace.v1.json" LogicalName="AgenticPrReview.Protocol.review-trace.v1.json" />
    <EmbeddedResource Include="..\..\..\protocol\schemas\provider-session-ledger.v1.json" LogicalName="AgenticPrReview.Protocol.provider-session-ledger.v1.json" />
  </ItemGroup>
</Project>
