{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SolusQuest/agentic-pr-review/runtime/tests/fixtures/action-host/trusted-proof/schemas/host-restricted-evidence.schema.json",
  "title": "R4 E3 host-restricted evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "identities",
    "fixture",
    "runs",
    "observation",
    "product",
    "state",
    "cleanup",
    "canaries"
  ],
  "properties": {
    "kind": { "const": "apr-r4-e3-host-restricted-evidence-v1" },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "workflow_sha",
        "action_source_sha",
        "payload_sha256",
        "reviewed_base_sha",
        "normal_head_sha",
        "stale_admitted_head_sha",
        "stale_advanced_head_sha"
      ],
      "properties": {
        "repository": { "const": "SolusQuest/agentic-pr-review" },
        "workflow_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "action_source_sha": { "const": "5b5769753653bb3fd3e68cf8b7bb88a1bd350613" },
        "payload_sha256": {
          "const": "97af2b7b0160e333862e74e5e421b2e802f3962d1bb6405c909301971a0130fc"
        },
        "reviewed_base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "normal_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "stale_admitted_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "stale_advanced_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normal_pr_number",
        "stale_pr_number",
        "normal_operation_id",
        "stale_operation_id",
        "base_canary_absent",
        "normal_direct_child",
        "stale_initial_direct_child",
        "stale_advance_direct_child",
        "only_changed_path",
        "normal_content_sha256",
        "stale_content_sha256"
      ],
      "properties": {
        "normal_pr_number": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
        "stale_pr_number": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
        "normal_operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "not": { "const": "7777777777777777777777777777777777777777777777777777777777777777" }
        },
        "stale_operation_id": {
          "const": "7777777777777777777777777777777777777777777777777777777777777777"
        },
        "base_canary_absent": { "const": true },
        "normal_direct_child": { "const": true },
        "stale_initial_direct_child": { "const": true },
        "stale_advance_direct_child": { "const": true },
        "only_changed_path": { "const": "proof/apr178-path-canary.txt" },
        "normal_content_sha256": {
          "const": "bc58613e9f389b973f1e44de64021a7acc748fafd857b7fa99466493670db446"
        },
        "stale_content_sha256": {
          "const": "20580dc6193f607a3a1d1b6949013796f8a8c9714d3e5586e4e509a473f1382a"
        }
      }
    },
    "runs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap", "continuation"],
      "properties": {
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "run_id",
            "run_attempt",
            "reviewed_head_sha",
            "concurrency_group",
            "barrier_ready_at",
            "completed_at",
            "cancelled"
          ],
          "properties": {
            "route": { "const": "workflow_run" },
            "run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
            "run_attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "reviewed_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "concurrency_group": { "type": "string", "minLength": 1, "maxLength": 128 },
            "barrier_ready_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "completed_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "cancelled": { "const": false }
          }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "route",
            "run_id",
            "run_attempt",
            "reviewed_head_sha",
            "concurrency_group",
            "created_at",
            "protected_job_started_at",
            "completed_at"
          ],
          "properties": {
            "route": { "const": "workflow_dispatch" },
            "run_id": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
            "run_attempt": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "reviewed_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "concurrency_group": { "type": "string", "minLength": 1, "maxLength": 128 },
            "created_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            "protected_job_started_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completed_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "run_one_status",
        "run_one_uncancelled",
        "run_two_status",
        "equal_evaluated_group",
        "privileged_job_allocated",
        "environment_admission_started",
        "preparation_started",
        "protected_step_started_at"
      ],
      "properties": {
        "observed_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "run_one_status": { "const": "in_progress" },
        "run_one_uncancelled": { "const": true },
        "run_two_status": { "enum": ["queued", "pending"] },
        "equal_evaluated_group": { "const": true },
        "privileged_job_allocated": { "const": false },
        "environment_admission_started": { "const": false },
        "preparation_started": { "const": false },
        "protected_step_started_at": { "type": "null" }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bootstrap", "continuation", "stale"],
      "properties": {
        "bootstrap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "sticky_comment_id",
            "sticky_comment_url",
            "sticky_marker",
            "candidate_artifact_id",
            "acceptance_receipt_id",
            "accepted_head_sha"
          ],
          "properties": {
            "summary": { "const": "Trusted proof complete." },
            "sticky_comment_id": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
            "sticky_comment_url": {
              "type": "string",
              "pattern": "^https://github\\.com/SolusQuest/agentic-pr-review/pull/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"
            },
            "sticky_marker": {
              "type": "string",
              "pattern": "^<!-- agentic-pr-review:r4:v1 scope_sha256=[0-9a-f]{64} body_sha256=[0-9a-f]{64} head_sha=[0-9a-f]{40} -->$"
            },
            "candidate_artifact_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "acceptance_receipt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "accepted_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "sticky_comment_id",
            "predecessor_acceptance_receipt_id",
            "candidate_artifact_id",
            "acceptance_receipt_id",
            "accepted_head_sha",
            "prior_only",
            "verified_ahead",
            "lineage_advanced"
          ],
          "properties": {
            "summary": { "const": "Trusted continuation complete." },
            "sticky_comment_id": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
            "predecessor_acceptance_receipt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "candidate_artifact_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "acceptance_receipt_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "accepted_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "prior_only": { "const": true },
            "verified_ahead": { "const": true },
            "lineage_advanced": { "const": true }
          }
        },
        "stale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "old_authorization_rejected",
            "privileged_job_allocated",
            "environment_admission_started",
            "provider_constructed",
            "state_mutated",
            "sticky_mutated",
            "accepted_lineage",
            "follow_on_terminal"
          ],
          "properties": {
            "old_authorization_rejected": { "const": true },
            "privileged_job_allocated": { "const": false },
            "environment_admission_started": { "const": false },
            "provider_constructed": { "const": false },
            "state_mutated": { "const": false },
            "sticky_mutated": { "const": false },
            "accepted_lineage": { "const": false },
            "follow_on_terminal": { "const": true }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_state", "created", "final_state"],
      "properties": {
        "pre_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_pagination_complete", "scoped_pagination_complete", "inventory"],
          "properties": {
            "root_pagination_complete": { "const": true },
            "scoped_pagination_complete": { "const": true },
            "inventory": { "type": "array", "maxItems": 0 }
          }
        },
        "created": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_name",
              "artifact_digest",
              "artifact_class",
              "creation_phase"
            ],
            "properties": {
              "artifact_id": { "type": "string", "minLength": 1, "maxLength": 128 },
              "artifact_name": { "type": "string", "minLength": 1, "maxLength": 256 },
              "artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "artifact_class": {
                "enum": [
                  "locator-root",
                  "lineage-head",
                  "candidate",
                  "publication-intent",
                  "acceptance",
                  "cleanup",
                  "transaction"
                ]
              },
              "creation_phase": { "enum": ["bootstrap", "continuation"] }
            }
          }
        },
        "final_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_pagination_complete", "scoped_pagination_complete", "inventory"],
          "properties": {
            "root_pagination_complete": { "const": true },
            "scoped_pagination_complete": { "const": true },
            "inventory": { "type": "array", "maxItems": 0 }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "barrier_cleanup_passed",
        "deleted_state_ids",
        "no_unowned_artifacts",
        "state_key_removed_after_final_readback",
        "terminal_resources"
      ],
      "properties": {
        "barrier_cleanup_passed": { "const": true },
        "deleted_state_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "no_unowned_artifacts": { "const": true },
        "state_key_removed_after_final_readback": { "const": true },
        "terminal_resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control_comments",
            "authorization_variable",
            "environment_settings",
            "operation_created_secrets",
            "fixture_branches",
            "fixture_prs",
            "product_sticky",
            "workflow_runs",
            "host_restricted_evidence"
          ],
          "properties": {
            "control_comments": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_class", "absence_readback"],
              "properties": {
                "terminal_class": { "const": "deleted" },
                "absence_readback": { "const": true }
              }
            },
            "authorization_variable": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_class", "absence_readback"],
              "properties": {
                "terminal_class": { "const": "deleted" },
                "absence_readback": { "const": true }
              }
            },
            "environment_settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_class", "exact_snapshot_readback"],
              "properties": {
                "terminal_class": { "const": "restored" },
                "exact_snapshot_readback": { "const": true }
              }
            },
            "operation_created_secrets": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_class", "absence_readback"],
              "properties": {
                "terminal_class": { "const": "deleted" },
                "absence_readback": { "const": true }
              }
            },
            "fixture_branches": {
              "type": "object",
              "additionalProperties": false,
              "required": ["normal", "stale"],
              "properties": {
                "normal": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["terminal_class", "absence_readback"],
                  "properties": {
                    "terminal_class": { "const": "deleted" },
                    "absence_readback": { "const": true }
                  }
                },
                "stale": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["terminal_class", "absence_readback"],
                  "properties": {
                    "terminal_class": { "const": "deleted" },
                    "absence_readback": { "const": true }
                  }
                }
              }
            },
            "fixture_prs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["normal", "stale"],
              "properties": {
                "normal": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["terminal_class", "state", "exact_readback"],
                  "properties": {
                    "terminal_class": { "const": "platform-retained-terminal" },
                    "state": { "const": "closed" },
                    "exact_readback": { "const": true }
                  }
                },
                "stale": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["terminal_class", "state", "exact_readback"],
                  "properties": {
                    "terminal_class": { "const": "platform-retained-terminal" },
                    "state": { "const": "closed" },
                    "exact_readback": { "const": true }
                  }
                }
              }
            },
            "product_sticky": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_class", "exact_readback"],
              "properties": {
                "terminal_class": { "const": "retained-public-evidence" },
                "exact_readback": { "const": true }
              }
            },
            "workflow_runs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_class", "all_terminal", "no_follow_on"],
              "properties": {
                "terminal_class": { "const": "platform-retained-terminal" },
                "all_terminal": { "const": true },
                "no_follow_on": { "const": true }
              }
            },
            "host_restricted_evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["terminal_class", "approved_destination"],
              "properties": {
                "terminal_class": { "const": "restricted-retained" },
                "approved_destination": { "const": true }
              }
            }
          }
        }
      }
    },
    "canaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_material_absent",
        "plaintext_session_absent",
        "provider_content_absent",
        "tool_data_absent",
        "permission_set_exact"
      ],
      "properties": {
        "secret_material_absent": { "const": true },
        "plaintext_session_absent": { "const": true },
        "provider_content_absent": { "const": true },
        "tool_data_absent": { "const": true },
        "permission_set_exact": { "const": true }
      }
    }
  }
}
