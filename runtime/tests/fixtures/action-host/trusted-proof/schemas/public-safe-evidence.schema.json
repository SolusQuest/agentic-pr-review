{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/SolusQuest/agentic-pr-review/runtime/tests/fixtures/action-host/trusted-proof/schemas/public-safe-evidence.schema.json",
  "title": "R4 E3 public-safe evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "identities",
    "participating_run_ids",
    "scheduling",
    "state_outcomes",
    "publication",
    "cleanup",
    "canaries"
  ],
  "properties": {
    "kind": { "const": "apr-r4-e3-public-safe-evidence-v1" },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_sha",
        "action_source_sha",
        "payload_sha256",
        "reviewed_base_sha",
        "normal_head_sha",
        "stale_admitted_head_sha",
        "stale_advanced_head_sha"
      ],
      "properties": {
        "workflow_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "action_source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "reviewed_base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "normal_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "stale_admitted_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "stale_advanced_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "participating_run_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concurrency_group_equal",
        "run_one_observed_running",
        "run_one_uncancelled",
        "run_two_observed_pending",
        "run_two_outside_protected_execution",
        "barrier_to_queue_delay_ms",
        "observation_to_run_one_completion_ms",
        "completion_to_run_two_start_ms"
      ],
      "properties": {
        "concurrency_group_equal": { "const": true },
        "run_one_observed_running": { "const": true },
        "run_one_uncancelled": { "const": true },
        "run_two_observed_pending": { "const": true },
        "run_two_outside_protected_execution": { "const": true },
        "barrier_to_queue_delay_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observation_to_run_one_completion_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "completion_to_run_two_start_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "state_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap",
        "continuation",
        "stale_rejection",
        "accepted_generations",
        "encrypted_state_record_count"
      ],
      "properties": {
        "bootstrap": { "const": "passed" },
        "continuation": { "const": "passed" },
        "stale_rejection": { "const": "passed" },
        "accepted_generations": { "const": 2 },
        "encrypted_state_record_count": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["comment_url", "marker", "reviewed_head_sha"],
      "properties": {
        "comment_url": {
          "type": "string",
          "pattern": "^https://github\\.com/SolusQuest/agentic-pr-review/pull/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"
        },
        "marker": {
          "type": "string",
          "pattern": "^<!-- agentic-pr-review:r4:v1 scope_sha256=[0-9a-f]{64} body_sha256=[0-9a-f]{64} head_sha=[0-9a-f]{40} -->$"
        },
        "reviewed_head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "final_state_inventory_count",
        "deleted_state_record_count",
        "authorization_absent",
        "operation_created_secrets_absent",
        "environment_restored",
        "fixture_branches_absent",
        "fixture_prs_closed",
        "all_runs_terminal",
        "all_follow_on_runs_terminal"
      ],
      "properties": {
        "complete": { "const": true },
        "final_state_inventory_count": { "const": 0 },
        "deleted_state_record_count": { "type": "integer", "minimum": 1, "maximum": 64 },
        "authorization_absent": { "const": true },
        "operation_created_secrets_absent": { "const": true },
        "environment_restored": { "const": true },
        "fixture_branches_absent": { "const": true },
        "fixture_prs_closed": { "const": true },
        "all_runs_terminal": { "const": true },
        "all_follow_on_runs_terminal": { "const": true }
      }
    },
    "canaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github",
        "actions",
        "provider",
        "current_state",
        "previous_state",
        "unrelated_credentials",
        "plaintext_session",
        "provider_content",
        "tool_data",
        "permission_set"
      ],
      "properties": {
        "github": { "const": "absent" },
        "actions": { "const": "absent" },
        "provider": { "const": "absent" },
        "current_state": { "const": "absent" },
        "previous_state": { "const": "absent" },
        "unrelated_credentials": { "const": "absent" },
        "plaintext_session": { "const": "absent" },
        "provider_content": { "const": "absent" },
        "tool_data": { "const": "absent" },
        "permission_set": { "const": "exact" }
      }
    }
  }
}
