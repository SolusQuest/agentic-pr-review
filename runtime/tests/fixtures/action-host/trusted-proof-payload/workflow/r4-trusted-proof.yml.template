name: R4 trusted proof
on:
  workflow_run:
    workflows:
      - CI
    types:
      - completed
  workflow_dispatch:
    inputs:
      pr-number:
        description: Pull request number
        required: true
        type: number
permissions: {}
concurrency:
  group: agentic-pr-review-r4-${{ github.repository_id }}-pr-${{ github.event.workflow_run.pull_requests[0].number || inputs.pr-number }}
  cancel-in-progress: false
jobs:
  authorization-preflight:
    runs-on: ubuntu-24.04
    permissions: {}
    outputs:
      authorized: ${{ steps.authorization.outputs.authorized }}
      pr-number: ${{ steps.authorization.outputs.pr-number }}
      fixture-head-sha: ${{ steps.authorization.outputs.fixture-head-sha }}
      operation-id: ${{ steps.authorization.outputs.operation-id }}
      authorization-manifest-digest: ${{ steps.authorization.outputs.authorization-manifest-digest }}
    steps:
      - id: authorization
        env:
          EVENT_NAME: ${{ github.event_name }}
          EVENT_ACTION: ${{ github.event.action }}
          EVENT_CONCLUSION: ${{ github.event.workflow_run.conclusion }}
          EVENT_PR_NUMBER: ${{ github.event.workflow_run.pull_requests[0].number }}
          EVENT_HEAD_SHA: ${{ github.event.workflow_run.pull_requests[0].head.sha }}
          EVENT_PULL_REQUESTS_JSON: ${{ toJSON(github.event.workflow_run.pull_requests) }}
          EVENT_WORKFLOW_ID: ${{ github.event.workflow_run.workflow_id }}
          EVENT_WORKFLOW_NAME: ${{ github.event.workflow_run.name }}
          EVENT_WORKFLOW_PATH: ${{ github.event.workflow_run.path }}
          EVENT_TRIGGER_EVENT: ${{ github.event.workflow_run.event }}
          EVENT_REPOSITORY: ${{ github.event.workflow_run.repository.full_name }}
          EVENT_REPOSITORY_ID: ${{ github.event.workflow_run.repository.id }}
          EVENT_HEAD_REPOSITORY: ${{ github.event.workflow_run.head_repository.full_name }}
          EVENT_HEAD_REPOSITORY_ID: ${{ github.event.workflow_run.head_repository.id }}
          INPUT_PR_NUMBER: ${{ inputs.pr-number }}
          REPOSITORY: ${{ github.repository }}
          REPOSITORY_ID: ${{ github.repository_id }}
          WORKFLOW_SHA: ${{ github.workflow_sha }}
          ACTION_SOURCE_SHA: __ACTION_SOURCE_SHA__
          PAYLOAD_SHA256: __PAYLOAD_SHA256__
          R4_TRUSTED_PROOF_AUTHORIZATION: ${{ vars.R4_TRUSTED_PROOF_AUTHORIZATION }}
        run: |
          node <<'APR_R4_E2P_PREFLIGHT' >> "$GITHUB_OUTPUT"
          (async () => {
            const fail = (code) => {
              throw new Error(code);
            };
            const required = (name, pattern) => {
              const value = process.env[name] ?? '';
              if (!pattern.test(value)) fail(`environment-${name}`);
              return value;
            };
            const rejectDuplicateKeys = (text) => {
              const stack = [];
              for (let index = 0; index < text.length; index += 1) {
                const character = text[index];
                if (character === '"') {
                  const start = index;
                  for (index += 1; index < text.length; index += 1) {
                    if (text[index] === '\\') {
                      index += 1;
                    } else if (text[index] === '"') {
                      break;
                    }
                  }
                  if (index >= text.length) fail('github-response-json');
                  let following = index + 1;
                  while (/\s/u.test(text[following] ?? '')) following += 1;
                  const object = stack.at(-1);
                  if (text[following] === ':' && object?.kind === 'object') {
                    const key = JSON.parse(text.slice(start, index + 1));
                    if (object.keys.has(key)) fail('github-response-duplicate-key');
                    object.keys.add(key);
                  }
                } else if (character === '{') {
                  stack.push({ kind: 'object', keys: new Set() });
                } else if (character === '[') {
                  stack.push({ kind: 'array' });
                } else if (character === '}' || character === ']') {
                  stack.pop();
                }
              }
            };
            const lowerHex40 = /^[0-9a-f]{40}$/u;
            const lowerHex64 = /^[0-9a-f]{64}$/u;
            const positiveInteger = /^(?:[1-9][0-9]{0,18})$/u;
            const repository = required(
              'REPOSITORY',
              /^SolusQuest\/agentic-pr-review$/u,
            );
            const repositoryId = required('REPOSITORY_ID', positiveInteger);
            const workflowSha = required('WORKFLOW_SHA', lowerHex40);
            const actionSourceSha = required('ACTION_SOURCE_SHA', lowerHex40);
            const payloadSha256 = required('PAYLOAD_SHA256', lowerHex64);
            const authorization = required(
              'R4_TRUSTED_PROOF_AUTHORIZATION',
              lowerHex64,
            );
            const eventName = required(
              'EVENT_NAME',
              /^(?:workflow_run|workflow_dispatch)$/u,
            );
            if (eventName === 'workflow_run') {
              const eventPullRequests = JSON.parse(
                required('EVENT_PULL_REQUESTS_JSON', /^\[[\s\S]{0,4096}\]$/u),
              );
              if (
                process.env.EVENT_ACTION !== 'completed' ||
                process.env.EVENT_CONCLUSION !== 'success' ||
                process.env.EVENT_WORKFLOW_ID !== '294554742' ||
                process.env.EVENT_WORKFLOW_NAME !== 'CI' ||
                process.env.EVENT_WORKFLOW_PATH !== '.github/workflows/ci.yml' ||
                process.env.EVENT_TRIGGER_EVENT !== 'pull_request' ||
                process.env.EVENT_REPOSITORY !== repository ||
                process.env.EVENT_REPOSITORY_ID !== repositoryId ||
                process.env.EVENT_HEAD_REPOSITORY !== repository ||
                process.env.EVENT_HEAD_REPOSITORY_ID !== repositoryId ||
                !Array.isArray(eventPullRequests) ||
                eventPullRequests.length !== 1 ||
                String(eventPullRequests[0]?.number) !==
                  process.env.EVENT_PR_NUMBER ||
                eventPullRequests[0]?.head?.sha !== process.env.EVENT_HEAD_SHA
              ) {
                fail('workflow-run-route-facts');
              }
            }
            const prNumber = required(
              eventName === 'workflow_run'
                ? 'EVENT_PR_NUMBER'
                : 'INPUT_PR_NUMBER',
              positiveInteger,
            );
            const response = await fetch(
              `https://api.github.com/repos/${repository}/pulls/${prNumber}`,
              {
                method: 'GET',
                headers: {
                  Accept: 'application/vnd.github+json',
                  'X-GitHub-Api-Version': '2022-11-28',
                },
                redirect: 'error',
                signal: AbortSignal.timeout(10000),
              },
            );
            if (!response.ok) fail(`github-status-${response.status}`);
            const responseBytes = new Uint8Array(await response.arrayBuffer());
            if (responseBytes.length === 0 || responseBytes.length > 65536) {
              fail('github-response-size');
            }
            const responseText = new TextDecoder('utf-8', {
              fatal: true,
            }).decode(responseBytes);
            rejectDuplicateKeys(responseText);
            const pull = JSON.parse(responseText);
            if (
              pull === null ||
              Array.isArray(pull) ||
              typeof pull !== 'object' ||
              String(pull.number) !== prNumber ||
              pull.state !== 'open' ||
              pull.draft !== false ||
              pull.base?.repo?.full_name !== repository ||
              String(pull.base?.repo?.id) !== repositoryId ||
              pull.head?.repo?.full_name !== repository ||
              String(pull.head?.repo?.id) !== repositoryId ||
              !lowerHex40.test(pull.head?.sha ?? '') ||
              !/^r4-trusted-proof\/[0-9a-f]{64}$/u.test(pull.head?.ref ?? '')
            ) {
              fail('pull-request-identity');
            }
            const fixtureHeadSha = pull.head.sha;
            if (
              eventName === 'workflow_run' &&
              (process.env.EVENT_HEAD_SHA !== fixtureHeadSha ||
                process.env.EVENT_PR_NUMBER !== prNumber)
            ) {
              fail('workflow-run-cross-check');
            }
            const operationId = pull.head.ref.slice('r4-trusted-proof/'.length);
            const manifest = JSON.stringify({
              kind: 'apr-r4-e2p-authorization-manifest-v1',
              repository_id: repositoryId,
              repository,
              pr_number: prNumber,
              fixture_head_sha: fixtureHeadSha,
              operation_id: operationId,
              workflow_sha: workflowSha,
              action_source_sha: actionSourceSha,
              payload_sha256: payloadSha256,
            });
            const digest = Array.from(
              new Uint8Array(
                await crypto.subtle.digest(
                  'SHA-256',
                  new TextEncoder().encode(manifest),
                ),
              ),
              (byte) => byte.toString(16).padStart(2, '0'),
            ).join('');
            if (digest !== authorization) fail('authorization-mismatch');
            process.stdout.write(
              `authorized=true\npr-number=${prNumber}\nfixture-head-sha=${fixtureHeadSha}\noperation-id=${operationId}\nauthorization-manifest-digest=${digest}\n`,
            );
          })().catch((error) => {
            const code =
              error instanceof Error && /^[a-z0-9-]{1,96}$/u.test(error.message)
                ? error.message
                : 'preflight-failed';
            process.stderr.write(`APR_R4_E2P_PREFLIGHT_REJECTED ${code}\n`);
            process.stdout.write(
              'authorized=false\npr-number=\nfixture-head-sha=\noperation-id=\nauthorization-manifest-digest=\n',
            );
          });
          APR_R4_E2P_PREFLIGHT
  workflow-run-review:
    needs: authorization-preflight
    if: ${{ github.event_name == 'workflow_run' && needs.authorization-preflight.outputs.authorized == 'true' }}
    runs-on: ubuntu-24.04
    environment: r4-trusted-proof
    permissions:
      actions: write
      contents: read
      pull-requests: write
    steps:
      - id: checkout-control-root
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          repository: SolusQuest/agentic-pr-review
          ref: ${{ github.workflow_sha }}
          path: control-root
          persist-credentials: false
      - id: checkout-payload-source
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          repository: SolusQuest/agentic-pr-review
          ref: __ACTION_SOURCE_SHA__
          path: payload-source
          persist-credentials: false
      - id: setup-node
        uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: 24
      - id: setup-dotnet
        uses: actions/setup-dotnet@26b0ec14cb23fa6904739307f278c14f94c95bf1
        with:
          dotnet-version: 10.0.109
      - id: install-native-aot-dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends clang zlib1g-dev
      - id: prepare
        run: |
          bash payload-source/runtime/scripts/prepare-r4-trusted-proof-payload.sh --source-root "$GITHUB_WORKSPACE/payload-source" --control-root "$GITHUB_WORKSPACE/control-root" --receipt "$GITHUB_WORKSPACE/control-root/runtime/tests/fixtures/action-host/trusted-proof/trusted-proof-payload-receipt.json" --output-root "$RUNNER_TEMP/r4-e2p-payload" --github-output "$GITHUB_OUTPUT"
      - id: barrier-hold
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPOSITORY: ${{ github.repository }}
          REPOSITORY_ID: ${{ github.repository_id }}
          PR_NUMBER: ${{ needs.authorization-preflight.outputs.pr-number }}
          FIXTURE_HEAD_SHA: ${{ needs.authorization-preflight.outputs.fixture-head-sha }}
          OPERATION_ID: ${{ needs.authorization-preflight.outputs.operation-id }}
          WORKFLOW_SHA: ${{ github.workflow_sha }}
          ACTION_SOURCE_SHA: __ACTION_SOURCE_SHA__
          PAYLOAD_SHA256: __PAYLOAD_SHA256__
          RUN_ID: ${{ github.run_id }}
          RUN_ATTEMPT: ${{ github.run_attempt }}
        run: |
          "${{ steps.prepare.outputs.prepared_root }}/${{ steps.prepare.outputs.prepared_executable }}" barrier hold
      - id: review
        uses: SolusQuest/agentic-pr-review/.github/actions/agentic-pr-review@__ACTION_SOURCE_SHA__
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          provider-api-key: ${{ secrets.DEEPSEEK_API_KEY }}
          state-key: ${{ secrets.AGENTIC_PR_REVIEW_STATE_KEY }}
          previous-state-key: ${{ secrets.AGENTIC_PR_REVIEW_PREVIOUS_STATE_KEY || '' }}
          config-path: .github/agentic-pr-review/trusted-proof.json
          pr-number: ''
          state-mode: auto
        env:
          AGENTIC_PR_REVIEW_PREPARED_ROOT: ${{ steps.prepare.outputs.prepared_root }}
          AGENTIC_PR_REVIEW_PREPARED_EXECUTABLE: ${{ steps.prepare.outputs.prepared_executable }}
          AGENTIC_PR_REVIEW_PREPARED_PAYLOAD_SHA256: ${{ steps.prepare.outputs.prepared_payload_sha256 }}
          AGENTIC_PR_REVIEW_ACTION_SOURCE_SHA: ${{ steps.prepare.outputs.action_source_sha }}
          AGENTIC_PR_REVIEW_PAYLOAD_BUILD_DISCRIMINATOR: ${{ steps.prepare.outputs.payload_build_discriminator }}
  workflow-dispatch-review:
    needs: authorization-preflight
    if: ${{ github.event_name == 'workflow_dispatch' && needs.authorization-preflight.outputs.authorized == 'true' }}
    runs-on: ubuntu-24.04
    environment: r4-trusted-proof
    permissions:
      actions: write
      contents: read
      pull-requests: write
    steps:
      - id: checkout-control-root
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          repository: SolusQuest/agentic-pr-review
          ref: ${{ github.workflow_sha }}
          path: control-root
          persist-credentials: false
      - id: checkout-payload-source
        uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
        with:
          repository: SolusQuest/agentic-pr-review
          ref: __ACTION_SOURCE_SHA__
          path: payload-source
          persist-credentials: false
      - id: setup-node
        uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38
        with:
          node-version: 24
      - id: setup-dotnet
        uses: actions/setup-dotnet@26b0ec14cb23fa6904739307f278c14f94c95bf1
        with:
          dotnet-version: 10.0.109
      - id: install-native-aot-dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends clang zlib1g-dev
      - id: prepare
        run: |
          bash payload-source/runtime/scripts/prepare-r4-trusted-proof-payload.sh --source-root "$GITHUB_WORKSPACE/payload-source" --control-root "$GITHUB_WORKSPACE/control-root" --receipt "$GITHUB_WORKSPACE/control-root/runtime/tests/fixtures/action-host/trusted-proof/trusted-proof-payload-receipt.json" --output-root "$RUNNER_TEMP/r4-e2p-payload" --github-output "$GITHUB_OUTPUT"
      - id: barrier-verify-completed
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPOSITORY: ${{ github.repository }}
          REPOSITORY_ID: ${{ github.repository_id }}
          PR_NUMBER: ${{ needs.authorization-preflight.outputs.pr-number }}
          FIXTURE_HEAD_SHA: ${{ needs.authorization-preflight.outputs.fixture-head-sha }}
          OPERATION_ID: ${{ needs.authorization-preflight.outputs.operation-id }}
          WORKFLOW_SHA: ${{ github.workflow_sha }}
          ACTION_SOURCE_SHA: __ACTION_SOURCE_SHA__
          PAYLOAD_SHA256: __PAYLOAD_SHA256__
          RUN_ID: ${{ github.run_id }}
          RUN_ATTEMPT: ${{ github.run_attempt }}
        run: |
          "${{ steps.prepare.outputs.prepared_root }}/${{ steps.prepare.outputs.prepared_executable }}" barrier verify-completed
      - id: review
        uses: SolusQuest/agentic-pr-review/.github/actions/agentic-pr-review@__ACTION_SOURCE_SHA__
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          provider-api-key: ${{ secrets.DEEPSEEK_API_KEY }}
          state-key: ${{ secrets.AGENTIC_PR_REVIEW_STATE_KEY }}
          previous-state-key: ${{ secrets.AGENTIC_PR_REVIEW_PREVIOUS_STATE_KEY || '' }}
          config-path: .github/agentic-pr-review/trusted-proof.json
          pr-number: ${{ inputs.pr-number }}
          state-mode: auto
        env:
          AGENTIC_PR_REVIEW_PREPARED_ROOT: ${{ steps.prepare.outputs.prepared_root }}
          AGENTIC_PR_REVIEW_PREPARED_EXECUTABLE: ${{ steps.prepare.outputs.prepared_executable }}
          AGENTIC_PR_REVIEW_PREPARED_PAYLOAD_SHA256: ${{ steps.prepare.outputs.prepared_payload_sha256 }}
          AGENTIC_PR_REVIEW_ACTION_SOURCE_SHA: ${{ steps.prepare.outputs.action_source_sha }}
          AGENTIC_PR_REVIEW_PAYLOAD_BUILD_DISCRIMINATOR: ${{ steps.prepare.outputs.payload_build_discriminator }}
