<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>AgenticPrReview.Runtime.AiAbstractionAotFixture</AssemblyName>
  </PropertyGroup>

  <Target Name="ValidateAiAbstractionCandidate" BeforeTargets="CollectPackageReferences;PrepareForBuild;PrepareForPublish">
    <Error
      Condition="'$(AiAbstractionCandidate)' != 'MicrosoftExtensionsAI' and '$(AiAbstractionCandidate)' != 'Minimal'"
      Text="APR_AI_CANDIDATE_INVALID: AiAbstractionCandidate must be exactly MicrosoftExtensionsAI or Minimal." />
  </Target>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Shared\**\*.cs" />
    <Compile
      Include="..\..\src\AgenticPrReview.Runtime\Agent\Chat\ProjectChat.cs"
      Link="SelectedProduction\ProjectChat.cs" />
    <Compile
      Include="..\..\src\AgenticPrReview.Runtime\Agent\Chat\MinimalChatClient.cs"
      Link="SelectedProduction\MinimalChatClient.cs"
      Condition="'$(AiAbstractionCandidate)' == 'Minimal'" />
    <Compile
      Include="Candidates\MicrosoftExtensionsAI\**\*.cs"
      Condition="'$(AiAbstractionCandidate)' == 'MicrosoftExtensionsAI'" />
    <Compile
      Include="Candidates\Minimal\**\*.cs"
      Condition="'$(AiAbstractionCandidate)' == 'Minimal'" />
  </ItemGroup>

  <ItemGroup Condition="'$(AiAbstractionCandidate)' == 'MicrosoftExtensionsAI'">
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.8.1" />
  </ItemGroup>
</Project>
