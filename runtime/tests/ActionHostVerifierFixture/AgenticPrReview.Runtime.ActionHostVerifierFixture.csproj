<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot Condition="'$(PublishAot)' == ''">false</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(PublishAot)' != 'true'">false</SelfContained>
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(PublishAot)' != 'true'">true</JsonSerializerIsReflectionEnabledByDefault>
    <AssemblyName>AgenticPrReview.Runtime.ActionHostVerifierFixture</AssemblyName>
    <DefineConstants>$(DefineConstants);ACTION_HOST_VERIFIER_FIXTURE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <SelfContained>true</SelfContained>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup Condition="'$(PublishAot)' != 'true'">
    <ProjectReference Include="..\..\src\AgenticPrReview.Runtime\AgenticPrReview.Runtime.csproj"
                      AdditionalProperties="ActionHostVerifierFrameworkReference=true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ActionHostTrustedProofPayload\TrustedProofOperationRequestAccounting.cs"
             Link="TrustedProofOperationRequestAccounting.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <ProjectReference Include="..\..\src\AgenticPrReview.Runtime\AgenticPrReview.Runtime.csproj"
                      AdditionalProperties="ActionHostVerifierAotReference=true" />
  </ItemGroup>
  <Target Name="ExportActionHostVerifierAotIntermediate"
          AfterTargets="ComputeIlcCompileInputs"
          BeforeTargets="IlcCompile"
          Condition="'$(PublishAot)' == 'true' and '$(ActionHostVerifierAotIntermediateDirectory)' != ''">
    <Error Condition="'@(ManagedBinary)' == ''"
           Text="APR_R4_E2_AOT_INTERMEDIATE_MISSING" />
    <Error Condition="'@(ManagedBinary->Count())' != '1'"
           Text="APR_R4_E2_AOT_INTERMEDIATE_AMBIGUOUS" />
    <ItemGroup>
      <_ActionHostRuntimeIntermediate Include="@(_ManagedResolvedAssembliesToPublish)"
                                      Condition="'%(Filename)' == 'AgenticPrReview.Runtime'" />
    </ItemGroup>
    <Error Condition="'@(_ActionHostRuntimeIntermediate)' == ''"
           Text="APR_R4_E2_AOT_RUNTIME_INTERMEDIATE_MISSING" />
    <Error Condition="'@(_ActionHostRuntimeIntermediate->Count())' != '1'"
           Text="APR_R4_E2_AOT_RUNTIME_INTERMEDIATE_AMBIGUOUS" />
    <MakeDir Directories="$(ActionHostVerifierAotIntermediateDirectory)" />
    <Copy SourceFiles="@(ManagedBinary)"
          DestinationFiles="@(ManagedBinary->'$(ActionHostVerifierAotIntermediateDirectory)/%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_ActionHostRuntimeIntermediate)"
          DestinationFiles="@(_ActionHostRuntimeIntermediate->'$(ActionHostVerifierAotIntermediateDirectory)/%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
