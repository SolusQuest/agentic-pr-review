<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AgenticPrReview.Runtime/AgenticPrReview.Runtime.csproj" />
  </ItemGroup>
  <Target Name="RequireManagedTools" BeforeTargets="_GenerateRestoreGraphProjectEntry;PrepareForBuild">
    <Error Condition="'$(APRManagedPackage)' != 'true'" Text="APR_SOLUS_TOOLS_REQUIRES_MANAGED" />
  </Target>
</Project>
