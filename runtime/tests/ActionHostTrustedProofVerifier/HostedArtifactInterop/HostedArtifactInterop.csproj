<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Existing friend identity, exclusively in this repository-only fixture. -->
    <AssemblyName>AgenticPrReview.Runtime.ActionHostTrustedProofVerifier</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/AgenticPrReview.Runtime/AgenticPrReview.Runtime.csproj" />
  </ItemGroup>
  <Target Name="PublicDependenciesOnly" BeforeTargets="_GenerateRestoreGraphProjectEntry;PrepareForBuild">
    <Error Condition="'$(APRManagedPackage)' == 'true'" Text="CR2_H1_PRIVATE_PACKAGE_PROFILE_REFUSED" />
  </Target>
</Project>
