<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);APR_HISTORICAL_FRAMEWORK_BRIDGE</DefineConstants>
    <Nullable>enable</Nullable>
    <AssemblyName>AgenticPrReview.Runtime.ActionHostTrustedProofVerifier</AssemblyName>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IsAotCompatible>$(PublishAot)</IsAotCompatible>
    <VerifyReferenceAotCompatibility>$(PublishAot)</VerifyReferenceAotCompatibility>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SharedHostPorts/HistoricalFixtureArtifactBridgeStore.cs" Link="Historical/HistoricalFixtureArtifactBridgeStore.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="SolusFresh/**/*.cs" />
    <Compile Remove="SolusRestored/**/*.cs" />
    <Compile Remove="ManagedArchive/**/*.cs" />
    <ProjectReference Include="..\..\src\AgenticPrReview.Runtime\AgenticPrReview.Runtime.csproj"
                      AdditionalProperties="ActionHostTrustedProofPayloadReference=true" />
    <ProjectReference Include="..\ActionHostTrustedProofPayload\AgenticPrReview.Runtime.ActionHostTrustedProofPayload.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ActionHostVerifierFixture\FrameworkCanaries.cs" Link="Synthetic\FrameworkCanaries.cs" />
    <Compile Include="..\ActionHostVerifierFixture\FrameworkCanaryCapture.cs" Link="Synthetic\FrameworkCanaryCapture.cs" />
    <Compile Include="..\ActionHostVerifierFixture\FrameworkGitHubHandler.cs" Link="Synthetic\FrameworkGitHubHandler.cs" />
    <Compile Include="..\ActionHostVerifierFixture\FrameworkJson.cs" Link="Synthetic\FrameworkJson.cs" />
    <Compile Include="..\ActionHostVerifierFixture\FrameworkPrimaryRateLimitBucket.cs" Link="Synthetic\FrameworkPrimaryRateLimitBucket.cs" />
    <Compile Include="..\ActionHostVerifierFixture\FrameworkStateDependencies.cs" Link="Synthetic\FrameworkStateDependencies.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ActionHostTrustedProofEvidenceContracts\AgenticPrReview.Runtime.ActionHostTrustedProofEvidenceContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../SharedHostPorts/HistoricalArtifactBridgeContracts.cs" Link="Historical/HistoricalArtifactBridgeContracts.cs" />
    <Compile Include="../SharedHostPorts/HistoricalArtifactBridgeJsonContext.cs" Link="Historical/HistoricalArtifactBridgeJsonContext.cs" />
    <Compile Include="../SharedHostPorts/HistoricalPrivateArtifactBridgeClient.cs" Link="Historical/HistoricalPrivateArtifactBridgeClient.cs" />
  </ItemGroup>
</Project>
