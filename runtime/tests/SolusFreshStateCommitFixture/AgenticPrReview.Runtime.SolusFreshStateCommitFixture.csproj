<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
    <PublishAot>false</PublishAot>
    <AssemblyName>AgenticPrReview.Runtime.ActionHostTrustedProofVerifier</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/AgenticPrReview.Runtime/AgenticPrReview.Runtime.csproj" />
    <Compile Include="../SharedHostPorts/ActionHostAuthorizationTestData.cs" Link="Ports/Authorization.cs" />
    <Compile Include="../ActionHostTrustedProofVerifier/SolusFresh/CorpusGitHub.cs" Link="Ports/CorpusGitHub.cs" />
    <Compile Include="../ActionHostTrustedProofVerifier/SolusFresh/ScriptedHandler.cs" Link="Ports/ScriptedHandler.cs" />
  </ItemGroup>
  <Target Name="RequireManagedStateCommitProof" BeforeTargets="_GenerateRestoreGraphProjectEntry;PrepareForBuild">
    <Error Condition="'$(APRManagedPackage)' != 'true'" Text="APR_SOLUS_STATE_COMMIT_PROOF_REQUIRES_MANAGED" />
  </Target>
  <ItemGroup>
    <Compile Include="../SharedHostPorts/HistoricalFixtureArtifactBridgeStore.cs" Link="Ports/HistoricalFixtureArtifactBridgeStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../SharedHostPorts/HistoricalArtifactBridgeContracts.cs" Link="Historical/HistoricalArtifactBridgeContracts.cs" />
    <Compile Include="../SharedHostPorts/HistoricalArtifactBridgeJsonContext.cs" Link="Historical/HistoricalArtifactBridgeJsonContext.cs" />
    <Compile Include="../SharedHostPorts/HistoricalPrivateArtifactBridgeClient.cs" Link="Historical/HistoricalPrivateArtifactBridgeClient.cs" />
  </ItemGroup>
</Project>
