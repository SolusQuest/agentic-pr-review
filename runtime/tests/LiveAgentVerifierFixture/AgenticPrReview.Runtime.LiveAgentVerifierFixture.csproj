<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>$(PublishAot)</IsAotCompatible>
    <VerifyReferenceAotCompatibility>$(PublishAot)</VerifyReferenceAotCompatibility>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <AssemblyName>AgenticPrReview.Runtime.LiveAgentVerifierFixture</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AgenticPrReview.Runtime\AgenticPrReview.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ActionHostTrustedProofEvidenceContracts\AgenticPrReview.Runtime.ActionHostTrustedProofEvidenceContracts.csproj" />
  </ItemGroup>
  <!-- Closed-environment apphost probes must also find a custom local SDK.
       Configure only this macOS fixture, without inheriting DOTNET_ROOT or
       changing the production launcher environment/global installation. The
       fixture and its test-reference copy have the same output-directory depth. -->
  <Target Name="ConfigureMacNativeFixtureAppHost"
          AfterTargets="_CreateAppHost"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) and '$(AppHostSourcePath)' != '' and Exists('$(AppHostIntermediatePath)')">
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(AppHostIntermediatePath)"
                   AppBinaryName="$(AssemblyName)$(TargetExt)"
                   IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   EnableMacOSCodeSign="true"
                   DotNetSearchLocations="AppRelative"
                   AppRelativeDotNet="$([System.IO.Path]::GetRelativePath('$(TargetDir)', '$(NetCoreRoot)'))" />
  </Target>
  <Target Name="ExportLiveAgentVerifierAotIntermediate"
          AfterTargets="ComputeIlcCompileInputs"
          BeforeTargets="IlcCompile"
          Condition="'$(PublishAot)' == 'true' and '$(LiveAgentVerifierAotIntermediateDirectory)' != ''">
    <Error Condition="'@(ManagedBinary)' == ''"
           Text="APR_R3_LIVE_AOT_INTERMEDIATE_MISSING" />
    <Error Condition="'@(ManagedBinary->Count())' != '1'"
           Text="APR_R3_LIVE_AOT_INTERMEDIATE_AMBIGUOUS" />
    <MakeDir Directories="$(LiveAgentVerifierAotIntermediateDirectory)" />
    <Copy SourceFiles="@(ManagedBinary)"
          DestinationFiles="@(ManagedBinary->'$(LiveAgentVerifierAotIntermediateDirectory)/%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
