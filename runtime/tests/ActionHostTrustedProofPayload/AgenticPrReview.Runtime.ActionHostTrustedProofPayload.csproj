<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AgenticPrReview.Runtime.ActionHostTrustedProofPayload</AssemblyName>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <Target Name="GeneratePayloadBuildIdentity" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PayloadBuildIdentitySource>$(IntermediateOutputPath)TrustedProofPayloadBuildIdentity.g.cs</PayloadBuildIdentitySource>
      <PayloadV2Identity>false</PayloadV2Identity>
      <PayloadV2Identity Condition="'$(PayloadSourceCommit)' != '' and '$(PayloadSourceTree)' != ''">true</PayloadV2Identity>
    </PropertyGroup>
    <Error Condition="('$(PayloadSourceCommit)' == '') != ('$(PayloadSourceTree)' == '')"
           Text="PayloadSourceCommit and PayloadSourceTree must be supplied together." />
    <Error Condition="'$(PayloadSourceCommit)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(PayloadSourceCommit)', '^[0-9a-f]{40}$'))"
           Text="PayloadSourceCommit must be an explicit lowercase 40-hex commit." />
    <Error Condition="'$(PayloadSourceTree)' != '' and !$([System.Text.RegularExpressions.Regex]::IsMatch('$(PayloadSourceTree)', '^[0-9a-f]{40}$'))"
           Text="PayloadSourceTree must be an explicit lowercase 40-hex tree." />
    <WriteLinesToFile File="$(PayloadBuildIdentitySource)"
                      Overwrite="true"
                      Lines="namespace AgenticPrReview.Runtime.ActionHostTrustedProofPayload%3B internal static class TrustedProofPayloadBuildIdentity { internal const bool StagedV2 = $(PayloadV2Identity)%3B internal const string SourceCommit = &quot;$(PayloadSourceCommit)&quot;%3B internal const string SourceTree = &quot;$(PayloadSourceTree)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(PayloadBuildIdentitySource)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AgenticPrReview.Runtime\AgenticPrReview.Runtime.csproj"
                      AdditionalProperties="ActionHostTrustedProofPayloadReference=true" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\fixtures\action-host\trusted-proof-payload\workflow\r4-trusted-proof-v2.yml.template"
                      LogicalName="AgenticPrReview.Runtime.ActionHostTrustedProofPayload.TrustedProofWorkflowTemplateV2" />
  </ItemGroup>
</Project>
