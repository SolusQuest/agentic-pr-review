<Project>
  <PropertyGroup Condition="'$(APRManagedPackage)' == 'true'">
    <RuntimeFrameworkVersion>10.0.9</RuntimeFrameworkVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <!-- Keep selected production restore/output state separate from public fixtures. -->
  <PropertyGroup Condition="'$(APRManagedPackage)' == 'true' and '$(MSBuildProjectName)' == 'AgenticPrReview.Runtime'">
    <BaseIntermediateOutputPath>obj/managed/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/managed/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetLockFilePath Condition="'$(NuGetLockFilePath)' == ''">$(MSBuildThisFileDirectory)src/AgenticPrReview.Runtime/packages.managed.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <Target Name="RejectRetiredNativeProductionPackage"
          BeforeTargets="_GenerateRestoreGraphProjectEntry;CollectPackageReferences;PrepareForBuild"
          Condition="'$(APRReleasePackage)' == 'true'">
    <Error Text="APR_NATIVE_PRODUCTION_PACKAGE_RETIRED" />
  </Target>
</Project>
